{
  "name": "snake-game",
  "productName": "Snake",
  "version": "1.0.4",
  "description": "A smooth, customizable Snake game for Windows.",
  "main": "main.js",
  "author": "Kazesikk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.example.snake",
    "productName": "Snake",
    "files": [
      "main.js",
      "index.html",
      "build/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Kazesikk",
      "repo": "snake-game",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}